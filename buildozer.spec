[app]
title = Kashif Master Bot
package.name = kashifbot
package.domain = org.kashif
source.dir = .
source.include_exts = py,txt,png,jpg,kv,atlas
version = 1.0
requirements = python3,kivy,requests,fake-useragent,plyer,android,urllib3,chardet,idna,certifi
orientation = portrait
fullscreen = 0
android.permissions = INTERNET,READ_EXTERNAL_STORAGE,WRITE_EXTERNAL_STORAGE
android.api = 33
android.minapi = 24
android.archs = arm64-v8a, armeabi-v7a
android.accept_sdk_license = True
